<Page
    x:Class="Memo.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Memo"
    Background="{StaticResource PaneBackgroundBrush}">

    <NavigationView PaneDisplayMode="Left"
                    OpenPaneLength="232"
                    CornerRadius="0"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="True">

        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>

            <!-- Green selection bar on the active nav item -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"
                             Color="{StaticResource PrimaryGreenColor}" />
        </NavigationView.Resources>

        <NavigationView.PaneCustomContent>
            <StackPanel Margin="12,16,12,12" Spacing="16">
                <TextBlock Text="Memo"
                           FontSize="28"
                           Margin="4,0,0,0"
                           FontFamily="{StaticResource HeaderFont}" />

                <Button Click="NewNotebook_Click"
                    PointerEntered="NewNotebookButton_PointerEntered"
                    PointerExited="NewNotebookButton_PointerExited"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Height="44"
                    Padding="14,0"
                    CornerRadius="4">       
                    <Button.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.15" />
                    </Button.TranslationTransition>
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#74997C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#82A98A" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6A8D72" />

                        <!-- Dark text for contrast, same in every state -->
                        <SolidColorBrush x:Key="ButtonForeground" Color="#14231A" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#14231A" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#14231A" />

                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New notebook" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </NavigationView.PaneCustomContent>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Icon="Home" IsSelected="True" />
            <NavigationViewItem Content="Library" Icon="Library" />
            <NavigationViewItem Content="Recent" Icon="Clock" />
            <NavigationViewItem Content="Trash" Icon="Delete" />
        </NavigationView.MenuItems>

        <Border BorderBrush="{StaticResource LightBorderBrush}"
                BorderThickness="1,0,0,0"
                Background="{StaticResource HomeContentBrush}">
            <ScrollViewer>
                <StackPanel Padding="48,64,48,48" Spacing="24">

                    <!-- Header: title + search -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Home"
                                   Style="{StaticResource TitleLargeTextBlockStyle}"
                                   FontSize="44"
                                   FontFamily="{StaticResource HeaderFont}" />
                        <AutoSuggestBox Grid.Column="1"
                                        Width="304" Margin="83,0,0,0"
                                        PlaceholderText="Search Memo"
                                        QueryIcon="Find" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Recent pages -->
                    <StackPanel Spacing="24">
                        <Grid ColumnSpacing="17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recent pages"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontSize="24"
                                       FontFamily="{StaticResource HeaderFont}" />
                            <Border Grid.Column="1" Height="1" VerticalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind RecentPages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:NotePage">
                                        <Border Width="176" Height="250" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid Padding="16" RowSpacing="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!-- thumbnail goes in row 0 later -->
                                                <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="2" Opacity="0.7"
                                                           Text="{x:Bind local:HomePage.FormatDate(LastModified)}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Notebooks -->
                    <StackPanel Spacing="24" Margin="0,16,0,0">
                        <Grid ColumnSpacing="17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Notebooks"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontSize="24"
                                       FontFamily="{StaticResource HeaderFont}" />
                            <Border Grid.Column="1" Height="1" VerticalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Grid>

                        <GridView x:Name="NotebookGrid"
                                  IsItemClickEnabled="True" SelectionMode="None"
                                  ItemClick="NotebookGrid_ItemClick">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:Notebook">
                                    <!-- Cover color is the placeholder; bind to a Notebook color later -->
                                    <Grid Width="172" Height="230"
                                          CornerRadius="3,6,6,3"
                                          Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Spine: translucent black, so it darkens any cover color -->
                                        <Border Grid.Column="0" Background="#33000000"
                                                CornerRadius="3,0,0,3" />

                                        <Grid Grid.Column="1" Padding="10,16,10,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{x:Bind Name}" FontSize="18"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="White" />
                                            <Border Grid.Row="1" Height="1" Margin="0,8,0,0"
                                                    Background="#80FFFFFF" />

                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12"
                                                           Foreground="White" Opacity="0.9"
                                                           Text="{x:Bind local:HomePage.FormatSectionCount(Sections.Count)}" />
                                                <Button Grid.Column="1" Background="Transparent"
                                                        BorderThickness="0" Padding="6,2"
                                                        Foreground="White">
                                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </Grid>

                                        <!-- Page edge -->
                                        <Border Grid.Column="2" Background="#F2E8DA"
                                                CornerRadius="0,6,6,0" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </NavigationView>
</Page>
